# ── Mode lokal (default, tanpa setup apa pun) ───────────────────────────────
# Aplikasi otomatis memakai PGlite (Postgres embedded) di ./.data/pglite.
# Tidak perlu mengisi env apa pun untuk menjalankan secara lokal.

# ── Mode Supabase / Postgres (produksi) ─────────────────────────────────────
# Isi ketiganya untuk mengaktifkan Supabase Auth + Postgres.
# Gunakan koneksi Supavisor transaction pooler (port 6543) untuk runtime.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Supabase Auth (login magic link + Google OAuth)
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Opsional ────────────────────────────────────────────────────────────────
# Lokasi data PGlite (default ./.data/pglite)
# PGLITE_DIR=.data/pglite
