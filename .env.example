# ── Mode lokal (default, tanpa setup apa pun) ───────────────────────────────
# Aplikasi otomatis memakai PGlite (Postgres embedded) di ./.data/pglite.
# Tidak perlu mengisi env apa pun untuk menjalankan secara lokal.

# ── Mode Supabase (auth + Postgres) ─────────────────────────────────────────
# Auth: kunci "publishable" (sb_publishable_…) atau anon key lama — keduanya didukung.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>   ← alternatif gaya lama

# Khusus server (jangan pakai awalan NEXT_PUBLIC_): diperlukan agar "Hapus akun"
# ikut menghapus user di Supabase Auth. Tanpa kunci ini, hapus akun tetap
# menghapus seluruh data keuangan, hanya akun login-nya yang tersisa.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   ← alternatif gaya lama

# Postgres runtime (salin dari Supabase → Connect):
#   - Dev lokal             → Direct connection:   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   - Vercel / serverless   → Transaction pooler:  postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Jangan biarkan placeholder seperti <ref>/<region> — aplikasi akan memakai PGlite bila terdeteksi.
# Setelah diisi, jalankan sekali: npm run db:migrate
# DATABASE_URL=

# ── Opsional ────────────────────────────────────────────────────────────────
# Lokasi data PGlite (default ./.data/pglite)
# PGLITE_DIR=.data/pglite

# ── Scan struk AI (opsional, gratis) ────────────────────────────────────────
# Isi SALAH SATU penyedia di bawah, lalu restart `npm run dev`.
# Foto hanya dikirim ke penyedia untuk dibaca; aplikasi tidak menyimpan foto.
# Pada free tier, penyedia dapat memakai data untuk meningkatkan layanannya.
#
# 1) Gemini (disarankan; free tier + structured output)
#    Ambil kunci di https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   # alternatif gratis: gemini-3.6-flash, gemini-3.5-flash-lite
#
# 2) OpenRouter (pilih model vision varian :free)
#    https://openrouter.ai/models?fmt=table&max_price=0
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
#
# 3) Ollama lokal (gratis penuh, jalan offline setelah model diunduh)
#    ollama pull qwen3-vl:4b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3-vl:4b
#
# Opsional: paksa provider / model tertentu (auto-detect bila kosong).
# RECEIPT_AI_PROVIDER=gemini
# RECEIPT_AI_MODEL=
