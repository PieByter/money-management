    "public.wallet_balances": {
      "name": "wallet_balances",
      "schema": "public",
      "columns": {
        "id": {
          "name": "id",
          "type": "uuid",
          "primaryKey": true,
          "notNull": true,
          "default": "gen_random_uuid()"
        },
        "user_id": {
          "name": "user_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select \"wallets\".\"id\", \"wallets\".\"user_id\", coalesce(sum(\n          case \"transactions\".\"kind\"\n            when 'income' then \"transactions\".\"amount\"\n            when 'transfer_in' then \"transactions\".\"amount\"\n            when 'adjustment_in' then \"transactions\".\"amount\"\n            when 'expense' then -\"transactions\".\"amount\"\n            when 'transfer_out' then -\"transactions\".\"amount\"\n            when 'adjustment_out' then -\"transactions\".\"amount\"\n            else 0\n          end\n        ), 0)::bigint as \"balance\" from \"wallets\" left join \"transactions\" on \"transactions\".\"wallet_id\" = \"wallets\".\"id\"\n            and \"transactions\".\"deleted_at\" is null\n            and \"transactions\".\"status\" = 'confirmed' group by \"wallets\".\"id\", \"wallets\".\"user_id\"",
      "materialized": false,
      "with": {
        "securityInvoker": true
      },
      "isExisting": false
    }
  },
